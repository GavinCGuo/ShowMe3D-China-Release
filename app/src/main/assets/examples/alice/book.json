  },
  {
   "id": "alice_08_title",
   "type": "TEXT",
   "source": "六点钟的证人",
   "displayName": "六点钟的证人",
   "locked": true,
   "faceViewer": true,
   "textBackgroundEnabled": true,
   "textColor": 4294963928
  },
  {
   "id": "alice_08_copy",
   "type": "TEXT",
   "source": "睡鼠从壶后露出脑袋：“一直都是六点，当然要一直喝茶。”桌底闪过白耳朵。爱丽丝这才发现，滴答声根本没停。",
   "displayName": "睡鼠从壶后露出脑袋：“一直都是六点，当然要一直喝茶。”桌底闪过白耳朵。爱丽丝这才发现，滴答声根本没停。",
   "locked": true,
